    axC.legend(fontsize=9)
    panel_label(axC, "(c)")

    # (d) Cher/Scint ratio (from produced photons)
    for med in MEDIA:
        if not any(e in data[med] for e in ENERGIES): continue
        Es = [e for e in ENERGIES if e in data[med]]
