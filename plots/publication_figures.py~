    panel_label(axB, "(b)")

    # (c) Bar: early vs late at 5 MeV
    early_vals, late_vals = [], []
    for med in MEDIA:
        t, counts = load_timing(results_dir, med, E_ref)
        if t is None:
            early_vals.append(0); late_vals.append(0)
