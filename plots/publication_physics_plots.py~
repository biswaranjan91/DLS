    n_det_5   = [(total_cherenkov_photons(5.,m)+total_scint_photons(5.,m))
                  * detection_efficiency_model(m,5.) for m in MEDIA]
    axC.bar(x_pos-0.2, n_det_1, 0.38, color=[COLORS[m] for m in MEDIA],
