_BMS_ABS /= _BMS_ABS.max()

# Cherenkov spectrum: d²N/dEdx ∝ sin²θ_c(λ) — broad UV/blue
_CHER_SPEC = np.where(_WL_SPEC > 270,
                       1./_WL_SPEC**2 * np.where(_WL_SPEC<500,1.,
                           np.exp(-(_WL_SPEC-500.)**2/60.**2)),
                       0.)
_CHER_SPEC /= _CHER_SPEC.max()


